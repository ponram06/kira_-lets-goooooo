# Copy this file to .env and fill in your real keys.
# Never commit .env to version control — it is listed in .gitignore.

GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
# Ollama runs locally and needs no key — leave this line absent or blank.

# Free-mode PIN (digits only, 4-12). Choose your own; leave blank to keep
# Free mode disabled. Never share it or commit it.
KIRA_FREE_MODE_PIN=
