# Secrets — never commit
.env

# Python virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw

# Distribution / packaging
*.egg-info/
dist/
build/

# Test artefacts
.pytest_cache/
.pytest_temp/
.test_run_tmp/
.coverage
htmlcov/

# Action logs
logs/

# Workspace contents (keep the folder, ignore what's inside)
workspace/*
!workspace/.gitkeep

# Editor
.vscode/settings.json
*.swp

# Audio files & temporary recordings
*.wav
*.mp3
*.ogg
*.pcm
*.flac
*.aac
.tmp_*

# Ephemeral runtime tokens (Step 6)
.kira/
.kira_token

# Avatar (Step 7)
avatar/node_modules/
avatar/dist/
avatar/assets/ryuk*.png

# Contacts (never commit real phone numbers)
contacts.yaml
