{
  "name": "kira-avatar",
  "version": "0.1.0",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "smoke:vrm": "electron scripts/vrm-smoke.js",
    "build:dir": "electron-builder --win --dir",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.185.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.kira.avatar",
    "productName": "Kira Avatar",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "dir",
        "portable"
      ]
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!tests/**/*",
      "!scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/backend",
        "to": "backend-dist",
        "filter": ["**/*"]
      }
    ]
  }
}
